PORT=4000

# Paths to your RSA key pair
# Generate with:
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Token expiry durations
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

NODE_ENV=development
DATABASE_URL=
RESEND_API_KEY=
INVITE_BASE_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins
# Local: not needed (defaults to http://localhost:3000)
# Production: set to your deployed frontend URL
ALLOWED_ORIGINS=https://your-app.vercel.app

# RSA keys for JWT signing
# Local dev: leave these blank, use JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH above
# Production (Railway): paste PEM content here with newlines replaced by \n
# To generate: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' keys/private.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=